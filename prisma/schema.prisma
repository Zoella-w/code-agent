generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id                 String   @id @default(uuid())
  title              String
  code                String
  question            String
  mode                String
  mainAnswer          String   @default("")
  verifyAnswer        String   @default("")
  verifyResultPassed  Boolean?
  toolSteps           Json     @default("[]")
  status              String   @default("idle")
  reviewMode          String   @default("code")
  prUrl               String   @default("")
  githubToken         String   @default("")
  createdAt           DateTime @default(now())
}

model Evaluation {
  id            String   @id @default(cuid())
  reviewOutput  String
  verifyOutput  String?
  label         String
  comment       String?
  superseded    Boolean  @default(false)
  timestamp     DateTime @default(now())
}

model PrReview {
  id             String   @id
  prUrl          String
  diff           String
  reviewResult   String   @default("")
  commentPosted  Boolean  @default(false)
  createdAt      DateTime @default(now())
}

/** 防滥用限流：按限流键（IP / 设备）累计 LLM 请求次数 */
model UsageLimit {
  key       String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}
